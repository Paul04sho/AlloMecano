# allomécano · Apache (Systalink)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS obligatoire (micro, localisation et notifications ne marchent qu'en HTTPS)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  # Sauf en local : localhost, 127.0.0.1 et les domaines .test (XAMPP)
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteCond %{HTTP_HOST} !\.test(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Fichiers existants servis tels quels, tout le reste passe par index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  # Assets versionnés (?v=…) : cache long
  <FilesMatch "\.(css|js|woff2|svg|webp|jpg|png|pmtiles)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Le service worker doit toujours être relu
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType application/octet-stream .pmtiles
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
