{
    "name": "dev-eyes/allomecano",
    "description": "allomécano : le mécano vérifié le plus proche, à Abidjan.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "minishlink/web-push": "^9.0",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 -t public public/index.php"
        ],
        "sprite": "php scripts/generer-sprite.php",
        "assets": "php scripts/construire-assets.php",
        "db:migrer-admins": "php scripts/migrer-admins.php",
        "db:installer": "php scripts/installer-base.php",
        "admin:initialiser": "php scripts/creer-admin-principal.php",
        "vapid": "php scripts/generer-cles-vapid.php",
        "db:demo": "php scripts/installer-base.php --demo --reinitialiser"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    },
    "scripts-descriptions": {
        "serve": "Lance le site sur http://localhost:8000 (Ctrl+C pour arrêter)",
        "db:demo": "Recrée la base locale avec les mécanos de démo (efface la base)"
    }
}
