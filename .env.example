# Copier en .env (jamais commité) et remplir.
APP_ENV=dev                 # dev | prod
APP_URL=http://localhost:8000
APP_DEBUG=1
APP_CLE=                    # 64 caractères aléatoires : php -r "echo bin2hex(random_bytes(32));"

DB_HOTE=127.0.0.1
DB_PORT=3306
DB_NOM=allomecano
DB_UTILISATEUR=root
DB_MOT_DE_PASSE=

# E-mails (SMTP Systalink)
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_EXPEDITEUR=bonjour@allomecano.ci
SMTP_NOM=allomécano

# Notifications web (php scripts/generer-cles-vapid.php)
VAPID_PUBLIQUE=
VAPID_PRIVEE=
VAPID_SUJET=mailto:bonjour@allomecano.ci

# Relais audio de l'appel intégré (Cloudflare Realtime TURN)
TURN_CLE_ID=
TURN_CLE_SECRET=

# Connexion Google (facultatif)
# Dans Google Cloud Console, ajouter cet URI de redirection autorisé :
# http://localhost:8000/pro/inscription/google/retour
# En production, utiliser l'URI HTTPS correspondant à APP_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Fond de carte (fichier PMTiles servi par nous, ou URL d'un fournisseur)
CARTE_SOURCE=/assets/carte/abidjan.pmtiles
